# LLM
# Which chat backend the discovery agent uses: groq | gemini | opencode-openai | opencode-anthropic
LLM_PROVIDER=groq
# Provider-specific model id, e.g.:
#   groq:               openai/gpt-oss-20b
#   gemini:             gemini-2.5-flash
#   opencode-openai:    deepseek-v4-pro (or kimi-k2.6, glm-5.2, ...)
#   opencode-anthropic: qwen3.7-plus (or minimax-m3, ...)
LLM_MODEL=openai/gpt-oss-20b

GROQ_API_KEY=
# Native Gemini API key (Google AI Studio) — required when LLM_PROVIDER=gemini
GEMINI_API_KEY=
# OpenCode Go key — required when LLM_PROVIDER=opencode-openai or opencode-anthropic
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1

# Database
DATABASE_URL=sqlite:///./leadforge.db

# Auth
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=1440

# Data sources
OVERSPASS_ENDPOINT=https://overpass-api.de/api/interpreter
NOMINATIM_ENDPOINT=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=leadforge

# Web
CORS_ORIGINS=http://localhost:3000

# Agent limits
MAX_AGENT_ITERATIONS=60
JOB_TIMEOUT_SECONDS=900

# Observability (LangSmith) — optional; leave LANGSMITH_TRACING=false to disable
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=leadforge
# LANGSMITH_ENDPOINT=            # optional; EU: https://eu.api.smith.langchain.com
